% texercises-lp.sty -- a rebuild of the TeXercises solver macros, from the TeXercises cheatsheet,
% so that exercises exported from TeXercises compile outside TeXercises (pdflatex).
% Not the original package: output can differ in details (rounding, box layout, material values).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texercises-lp}[2026/10/11 TeXercises macros, rebuilt]
\RequirePackage[dvipsnames,svgnames,table]{xcolor}
\RequirePackage{amsmath,amssymb,mathtools,xfp,siunitx,graphicx,tikz,ulem,enumitem,multicol,ifthen}
\RequirePackage{float,tabularx,array,booktabs,adjustbox,url,upgreek,textcomp,cancel}
\RequirePackage[version=4]{mhchem}
\RequirePackage{tcolorbox}\tcbuselibrary{most}
\RequirePackage[european resistors]{circuitikz}
% tkz-fct (function plots, needs gnuplot for the curves) has to come before tkz-euclide
\IfFileExists{tkz-fct.sty}{\RequirePackage{tkz-fct}}{}
\IfFileExists{tkz-euclide.sty}{\RequirePackage{tkz-euclide}}{}
\IfFileExists{chessfss.sty}{\RequirePackage{chessfss}}{}
\normalem\urlstyle{same}\g@addto@macro\UrlBreaks{\do\-}
\usetikzlibrary{arrows.meta,calc,decorations.pathmorphing,decorations.markings,patterns,positioning,angles,quotes,shapes}

% \qty: siunitx' \qty[options]{value}{unit}, or physics-style \qty( ... ) and \qty[ ... ] for big
% parentheses and brackets (a [...] not followed by { is a bracket)
\ExplSyntaxOn
\AtBeginDocument
  {
    \NewCommandCopy \__txlp_siqty:w \qty
    \RenewDocumentCommand \qty { }
      {
        \peek_charcode:NTF (
          { \__txlp_paren:w }
          { \peek_charcode:NTF [ { \__txlp_brack:w } { \__txlp_siqty:w } }
      }
  }
\cs_new:Npn \__txlp_paren:w (#1) { \left( #1 \right) }
\cs_new_protected:Npn \__txlp_brack:w [#1]
  { \peek_catcode:NTF \c_group_begin_token { \__txlp_siqty:w [#1] } { \left[ #1 \right] } }
\ExplSyntaxOff
\providecommand\abs[1]{\left|#1\right|}
\providecommand\norm[1]{\left\|#1\right\|}
\providecommand\dd[1]{\mathrm{d}#1}
\providecommand\dv[2]{\frac{\mathrm{d}#1}{\mathrm{d}#2}}
\providecommand\pdv[2]{\frac{\partial#1}{\partial#2}}
% unit macros also work outside \unit (\m, \A, \ohm print the unit), as in TeXercises
\sisetup{free-standing-units=true,overwrite-commands=false,unit-optional-argument=false,space-before-unit=false,use-xspace=false}
\sisetup{exponent-thresholds=-3:3,per-mode=symbol,output-decimal-marker={.},exponent-product=\cdot,separate-uncertainty=true}

% ---------------------------------------------------------------- language
\newif\iftxde
\newcommand\txlang[1]{\def\@tmp{#1}\def\@de{de}\ifx\@tmp\@de\txdetrue\else\txdefalse\fi}
\newcommand\DuSie[2]{#2}
\let\duSie\DuSie
\newcommand\txGiven{\iftxde Gegeben\else Given\fi}
\newcommand\txWanted{\iftxde Gesucht\else Wanted\fi}
\newcommand\txSolution{\iftxde Lösung\else Solution\fi}
% the sheet builder marks the solver part: \Waerme and \Dichte print nothing there
\newif\iftxpreamble
\newcommand\txinpreamble{\txpreambletrue}
\newcommand\txendpreamble{\txpreamblefalse}

% ---------------------------------------------------------------- quantities
% Definitions are local: an exercise run in a group does not leak its names into the next one.
% For every quantity <x>: \<x>X (SI number, expandable), \<x>U (SI unit), \<x>F (formula),
% \<x> (4 figures), \<x>S{n}, \<x>P{p}{n}, \<x>Q, \<x>I; given quantities also \<x>O (as typed),
% \<x>OX (number as typed) and \<x>OU (unit as typed, siunitx unit macros).
\ExplSyntaxOn
\tl_new:N \l__txlp_val_tl
\tl_new:N \l__txlp_fac_tl
\tl_new:N \l__txlp_x_tl
\tl_new:N \l__txlp_r_tl
\tl_new:N \l__txlp_u_tl
\tl_new:N \l__txlp_expr_tl
\tl_new:N \l__txlp_opt_tl
\int_new:N \l__txlp_paren_int
\cs_generate_variant:Nn \tl_if_blank:nTF { V }

% fp evaluation into a tl; closes parentheses left open by the author
\cs_new_protected:Npn \__txlp_fpset:Nn #1#2
  {
    \tl_set:Nn \l__txlp_expr_tl {#2}
    \int_zero:N \l__txlp_paren_int
    \tl_map_inline:Nn \l__txlp_expr_tl
      {
        \tl_if_eq:nnT {##1} { ( } { \int_incr:N \l__txlp_paren_int }
        \tl_if_eq:nnT {##1} { ) } { \int_decr:N \l__txlp_paren_int }
      }
    \int_compare:nNnT \l__txlp_paren_int > 0
      { \tl_put_right:Nx \l__txlp_expr_tl { \prg_replicate:nn { \l__txlp_paren_int } { ) } } }
    \int_compare:nNnT \l__txlp_paren_int < 0
      { \tl_put_left:Nx \l__txlp_expr_tl { \prg_replicate:nn { - \l__txlp_paren_int } { ( } } }
    \tl_set:Nx #1 { \fp_eval:n { \l__txlp_expr_tl } }
  }
% #1 := #2 rounded to #3 significant figures (no padding zeros)
\cs_new_protected:Npn \__txlp_figures:Nnn #1#2#3
  {
    \fp_compare:nNnTF {#2} = { 0 }
      { \tl_set:Nn #1 { 0 } }
      { \tl_set:Nx #1 { \fp_eval:n { round( #2 , #3 - 1 - floor( ln(abs(#2)) / ln(10) + 1e-9 ) ) } } }
  }
% siunitx options: TeXercises' scientific-notation=true/false, the rest passed on
\cs_new_protected:Npn \__txlp_opts:Nn #1#2
  {
    \tl_set:Nn #1 {#2}
    \tl_replace_all:Nnn #1 { scientific-notation=false } { exponent-mode=fixed,fixed-exponent=0 }
    \tl_replace_all:Nnn #1 { scientific-notation=true } { exponent-mode=scientific }
  }
% \__txlp_print:nnn {options} {number} {unit}; siunitx' own \SI and \num, kept even when an
% exercise defines a quantity S (whose integer form would be \SI)
\NewCommandCopy \__txlp_SI:w \SI
\NewCommandCopy \__txlp_num:w \num
\cs_new_protected:Npn \__txlp_print:nnn #1#2#3
  {
    \tl_if_blank:nTF {#3}
      { \__txlp_num:w [#1] {#2} }
      {
        % a unit written as \frac{km}{h} only works in math
        \tl_if_in:nnTF {#3} { \frac }
          { \__txlp_SI:w [#1, mode=math] {#2} {#3} }
          { \__txlp_SI:w [#1] {#2} {#3} }
      }
  }
\cs_new_protected:Npn \__txlp_prefixed:nnnnn #1#2#3#4#5
  % #1 options, #2 number, #3 unit, #4 power of ten, #5 figures
  {
    \tl_set:Nx \l__txlp_x_tl { \fp_eval:n { (#2) / 10^(#4) } }
    \__txlp_print:nnn
      { round-mode=figures, round-precision=#5, exponent-mode=fixed, fixed-exponent=0, #1 }
      { \l__txlp_x_tl }
      { \__txlp_prefix:n {#4} #3 }
  }
\cs_new:Npn \__txlp_prefix:n #1
  {
    \int_case:nnF {#1}
      { {-18}{\atto} {-15}{\femto} {-12}{\pico} {-9}{\nano} {-6}{\micro} {-3}{\milli} {-2}{\centi} {-1}{\deci}
        {0}{} {2}{\hecto} {3}{\kilo} {6}{\mega} {9}{\giga} {12}{\tera} {15}{\peta} }
      { }
  }
% names whose plain form would replace a LaTeX command that the page itself needs
\clist_const:Nn \c__txlp_reserved_clist
  { value , par , item , text , label , ref , begin , end , the , relax , left , right , frac , sqrt , cdot , times , hline , quad , phantom }
% may \<name> itself be defined? not for the reserved names, and not over a TeX primitive
% (a quantity dp must not replace \dp, the depth of a box, which LaTeX itself uses)
\prg_new_conditional:Npnn \__txlp_plain_ok:n #1 { TF , T }
  {
    \clist_if_in:NnTF \c__txlp_reserved_clist {#1}
      { \prg_return_false: }
      {
        \cs_if_exist:cTF {#1}
          { \exp_args:Nc \token_if_primitive:NTF {#1} { \prg_return_false: } { \prg_return_true: } }
          { \prg_return_true: }
      }
  }
% the printed forms; #1 name, #2 SI unit, #3 options
\cs_new_protected:Npn \__txlp_printers:nnn #1#2#3
  {
    \cs_set:cpn { #1U } { \unit {#2} }
    \__txlp_plain_ok:nT {#1}
    { \cs_set_protected:cpn { #1 }
      { \__txlp_print:nnn { round-mode=figures, round-precision=4, exponent-mode=threshold, #3 } { \use:c {#1X} } {#2} } }
    \cs_set_protected:cpn { #1S } ##1
      { \__txlp_print:nnn { round-mode=figures, round-precision=##1, exponent-mode=threshold, #3 } { \use:c {#1X} } {#2} }
    \cs_set_protected:cpn { #1Q }
      { \__txlp_print:nnn { round-mode=figures, round-precision=4, exponent-mode=fixed, fixed-exponent=0, #3 } { \use:c {#1X} } {#2} }
    \str_if_eq:nnF {#1} { S } { \cs_set_protected:cpn { #1I }
      { \__txlp_print:nnn { round-mode=places, round-precision=0, exponent-mode=fixed, fixed-exponent=0, #3 } { \use:c {#1X} } {#2} } }
    \cs_set_protected:cpn { #1P } ##1##2
      { \__txlp_prefixed:nnnnn {#3} { \use:c {#1X} } {#2} {##1} {##2} }
  }
\cs_generate_variant:Nn \__txlp_printers:nnn { nVV , nVn }
\cs_new_protected:Npn \__txlp_given_plain:nnn #1#2#3
  {
    \__txlp_plain_ok:nT {#1}
      { \cs_set_protected:cpn {#1} { \__txlp_print:nnn { exponent-mode=threshold, round-mode=figures, round-precision=4, round-pad=false } {#2} {#3} } }
  }
\cs_generate_variant:Nn \__txlp_given_plain:nnn { nVV }

% \NewQty{name}{value}[unit][factor][SI unit]
%   factor e-3 (or E-3) is appended to the value; any other factor, or the starred form, multiplies
% \NewQty[siunitx options]... : the options apply to the printed forms
\NewDocumentCommand \NewQty { s O{} m m o o o }
  { \tl_if_blank:nF {#3} { \__txlp_newqty:nnnnnnn {#1} {#3} {#4} {#5} {#6} {#7} {#2} } }
\cs_new_protected:Npn \__txlp_newqty:nnnnnnn #1#2#3#4#5#6#7
  {
    \tl_set:Nn \l__txlp_val_tl {#3}
    \tl_replace_all:Nnn \l__txlp_val_tl { , } { . }
    % an uncertainty 3.2(1) or 3.2+-0.1 does not enter the number
    \regex_replace_once:nnN { \(\d+\)\Z } { } \l__txlp_val_tl
    \regex_replace_once:nnN { \+\-.*\Z } { } \l__txlp_val_tl
    \regex_replace_once:nnN { \A([eE]) } { 1\1 } \l__txlp_val_tl
    \tl_set:Nx \l__txlp_val_tl { \l__txlp_val_tl }
    \tl_clear:N \l__txlp_fac_tl
    \IfValueT {#5} { \tl_set:Nn \l__txlp_fac_tl {#5} }
    \tl_if_blank:VTF \l__txlp_fac_tl
      { \__txlp_fpset:Nn \l__txlp_x_tl { \l__txlp_val_tl } }
      {
        \bool_lazy_and:nnTF
          { ! #1 }
          { \bool_lazy_or_p:nn { \str_if_eq_p:ee { \tl_head:N \l__txlp_fac_tl } { e } } { \str_if_eq_p:ee { \tl_head:N \l__txlp_fac_tl } { E } } }
          { \__txlp_fpset:Nn \l__txlp_x_tl { ( \l__txlp_val_tl ) * 1 \l__txlp_fac_tl } }
          { \__txlp_fpset:Nn \l__txlp_x_tl { ( \l__txlp_val_tl ) * ( \l__txlp_fac_tl ) } }
      }
    % X keeps 12 figures (no binary-looking tails); \<x> prints at most 4, without padding zeros
    \__txlp_figures:NVn \l__txlp_r_tl \l__txlp_x_tl { 4 }
    \__txlp_figures:NVn \l__txlp_x_tl \l__txlp_x_tl { 12 }
    \tl_clear:N \l__txlp_u_tl
    \IfValueT {#4} { \tl_set:Nn \l__txlp_u_tl {#4} }
    \IfValueT {#6} { \tl_if_blank:nF {#6} { \tl_set:Nn \l__txlp_u_tl {#6} } }
    \cs_set:cpx { #2X } { \l__txlp_x_tl }
    \cs_set:cpx { #2OX } { \l__txlp_val_tl }
    \IfValueTF {#4}
      {
        \cs_set:cpn { #2OU } {#4}
        \cs_set_protected:cpn { #2O } { \__txlp_print:nnn {#7} {#3} {#4} }
      }
      {
        \cs_set:cpn { #2OU } { }
        \cs_set_protected:cpn { #2O } { \__txlp_print:nnn {#7} {#3} { } }
      }
    \cs_set:cpn { #2F } {#2}
    \__txlp_printers:nVn {#2} \l__txlp_u_tl {#7}
    \__txlp_given_plain:nVV {#2} \l__txlp_r_tl \l__txlp_u_tl
  }
\cs_generate_variant:Nn \__txlp_figures:Nnn { NV }
% \SolQty[siunitx options]{name}[formula]{xfp expression}[SI unit]
\NewDocumentCommand \SolQty { O{} m o m o }
  {
    \__txlp_fpset:Nn \l__txlp_x_tl {#4}
    \cs_set:cpx { #2X } { \l__txlp_x_tl }
    \IfNoValueTF {#3} { \cs_set:cpn { #2F } {#2} } { \cs_set:cpn { #2F } {#3} }
    \__txlp_opts:Nn \l__txlp_opt_tl {#1}
    \IfValueTF {#5} { \tl_set:Nn \l__txlp_u_tl {#5} } { \tl_clear:N \l__txlp_u_tl }
    \__txlp_printers:nVV {#2} \l__txlp_u_tl \l__txlp_opt_tl
    \__txlp_plain_ok:nT {#2} { \cs_set_eq:cc { #2O } { #2 } }
  }
% \ConvTo{new}{factor}{old}{unit}
\NewDocumentCommand \ConvTo { m m m m }
  {
    \__txlp_fpset:Nn \l__txlp_x_tl { \use:c {#3X} * ( #2 ) }
    \cs_set:cpx { #1X } { \l__txlp_x_tl }
    \cs_set_eq:cc { #1F } { #3F }
    \__txlp_printers:nnn {#1} {#4} { }
  }
\ExplSyntaxOff

