% texercises-lp.sty -- a rebuild of the TeXercises solver macros, from the TeXercises cheatsheet,
% so that exercises exported from TeXercises compile outside TeXercises.
% Not the original package: output can differ in details (rounding, box layout).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texercises-lp}[2026/10/11 TeXercises macros, rebuilt]
\RequirePackage{amsmath,amssymb,xfp,siunitx,graphicx,xcolor,tikz,ulem,enumitem,multicol}
\RequirePackage[version=4]{mhchem}
\RequirePackage{tcolorbox}\tcbuselibrary{most}
\RequirePackage{circuitikz}
\IfFileExists{tkz-fct.sty}{\RequirePackage{tkz-fct}}{}
\normalem
\usetikzlibrary{arrows.meta,calc,decorations.pathmorphing,patterns}

% \qty: siunitx' \qty{value}{unit}, or physics-style \qty( ... ) for big parentheses
\ExplSyntaxOn
\AtBeginDocument
  {
    \cs_gset_eq:NN \__txlp_siqty:w \qty
    \RenewDocumentCommand \qty { } { \peek_charcode:NTF ( { \__txlp_paren:w } { \__txlp_siqty:w } }
  }
\cs_new:Npn \__txlp_paren:w (#1) { \left( #1 \right) }
\ExplSyntaxOff
\providecommand\abs[1]{\left|#1\right|}
\providecommand\dd[1]{\mathrm{d}#1}
\providecommand\dv[2]{\frac{\mathrm{d}#1}{\mathrm{d}#2}}
\sisetup{per-mode=symbol,output-decimal-marker={.},exponent-product=\cdot,separate-uncertainty=true}

% ---------------------------------------------------------------- language
\newif\iftxde
\newcommand\txlang[1]{\def\@tmp{#1}\def\@de{de}\ifx\@tmp\@de\txdetrue\else\txdefalse\fi}
\newcommand\DuSie[2]{#2}
\newcommand\txGiven{\iftxde Gegeben\else Given\fi}
\newcommand\txWanted{\iftxde Gesucht\else Wanted\fi}
\newcommand\txSolution{\iftxde Lösung\else Solution\fi}

% ---------------------------------------------------------------- quantities
\ExplSyntaxOn
\fp_new:N \l__txlp_fp
\tl_new:N \l__txlp_x_tl
\tl_new:N \l__txlp_u_tl
% a quantity <name>: X (SI number), U (SI unit), O (as given), F (formula), and the printed forms
\cs_new_protected:Npn \__txlp_define:nnnn #1#2#3#4
  % #1 name, #2 SI number (expanded), #3 SI unit, #4 formula
  {
    \cs_gset:cpn { #1X } { #2 }
    \cs_gset:cpn { #1U } { \unit{#3} }
    \cs_gset:cpn { #1F } { #4 }
    \cs_gset_protected:cpn { #1 }  { \SI[round-mode=figures,round-precision=4,exponent-mode=threshold,exponent-thresholds=-3:3]{#2}{#3} }
    \cs_gset_protected:cpn { #1S } ##1 { \SI[round-mode=figures,round-precision=##1,exponent-mode=threshold,exponent-thresholds=-3:3]{#2}{#3} }
    \cs_gset_protected:cpn { #1Q } { \SI[round-mode=figures,round-precision=4,exponent-mode=fixed,fixed-exponent=0]{#2}{#3} }
    \cs_gset_protected:cpn { #1I } { \SI[round-mode=places,round-precision=0]{#2}{#3} }
    \cs_gset_protected:cpn { #1P } ##1##2 { \__txlp_prefixed:nnnn {#2} {#3} {##1} {##2} }
  }
\cs_new_protected:Npn \__txlp_prefixed:nnnn #1#2#3#4
  {
    \SI[round-mode=figures,round-precision=#4,exponent-mode=fixed,fixed-exponent=0]
      { \fp_eval:n { (#1) / 10^(#3) } }
      { \__txlp_prefix:n {#3} #2 }
  }
\cs_new:Npn \__txlp_prefix:n #1
  {
    \int_case:nnF {#1}
      { {-15}{\femto} {-12}{\pico} {-9}{\nano} {-6}{\micro} {-3}{\milli} {-2}{\centi} {-1}{\deci}
        {0}{} {3}{\kilo} {6}{\mega} {9}{\giga} {12}{\tera} }
      { }
  }
% \NewQty{name}{value}[unit][factor][SI unit]; * = factor multiplies instead of a power of ten
\NewDocumentCommand \NewQty { s m m o o o }
  {
    \IfNoValueTF {#5}
      { \tl_set:Nx \l__txlp_x_tl { \fp_eval:n {#3} } \tl_set:Nn \l__txlp_u_tl {#4} }
      {
        \IfBooleanTF {#1}
          { \tl_set:Nx \l__txlp_x_tl { \fp_eval:n { (#3) * (#5) } } }
          { \tl_set:Nx \l__txlp_x_tl { \fp_eval:n { #3 #5 } } }
        \IfNoValueTF {#6} { \tl_set:Nn \l__txlp_u_tl {#4} } { \tl_set:Nn \l__txlp_u_tl {#6} }
      }
    \IfNoValueTF {#4} { \tl_clear:N \l__txlp_u_tl } { }
    \exp_args:NnV \__txlp_define_given:nnnn {#2} \l__txlp_x_tl {#3} {#4}
    \exp_args:NnV \__txlp_define_u:nnn {#2} \l__txlp_u_tl { }
  }
\cs_new_protected:Npn \__txlp_define_given:nnnn #1#2#3#4
  {
    \cs_gset:cpn { #1X } { #2 }
    \cs_gset_protected:cpn { #1O } { \IfNoValueTF {#4} { \num{#3} } { \SI{#3}{#4} } }
    \cs_gset:cpn { #1F } { #1 }
  }
\cs_new_protected:Npn \__txlp_define_u:nnn #1#2#3
  {
    \cs_gset:cpn { #1U } { \unit{#2} }
    \cs_gset_protected:cpn { #1 } { \SI[exponent-mode=threshold,exponent-thresholds=-3:3]{ \use:c{#1X} }{#2} }
    \cs_gset_protected:cpn { #1S } ##1 { \SI[round-mode=figures,round-precision=##1,exponent-mode=threshold,exponent-thresholds=-3:3]{ \use:c{#1X} }{#2} }
    \cs_gset_protected:cpn { #1Q } { \SI[round-mode=figures,round-precision=4]{ \use:c{#1X} }{#2} }
    \cs_gset_protected:cpn { #1I } { \SI[round-mode=places,round-precision=0]{ \use:c{#1X} }{#2} }
    \cs_gset_protected:cpn { #1P } ##1##2 { \__txlp_prefixed:nnnn { \use:c{#1X} } {#2} {##1} {##2} }
  }
% \SolQty{name}[formula]{xfp expression}[SI unit]
\NewDocumentCommand \SolQty { m o m o }
  {
    \tl_set:Nx \l__txlp_x_tl { \fp_eval:n {#3} }
    \exp_args:NnV \__txlp_define:nnnn {#1} \l__txlp_x_tl { \IfNoValueTF{#4}{}{#4} } { \IfNoValueTF{#2}{#1}{#2} }
  }
% \ConvTo{new}{factor}{old}{unit}
\NewDocumentCommand \ConvTo { m m m m }
  {
    \tl_set:Nx \l__txlp_x_tl { \fp_eval:n { \use:c{#3X} * (#2) } }
    \exp_args:NnV \__txlp_define:nnnn {#1} \l__txlp_x_tl {#4} { \use:c{#3F} }
  }
\ExplSyntaxOff

