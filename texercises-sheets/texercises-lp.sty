% ---------------------------------------------------------------- material values
% \<k><Xx>: k = c (specific heat), Lf, Lv (latent heats), Tf, Tv (melting, boiling point in °C),
% R (density), a = al (linear expansion), g (volume expansion), r (resistivity), l (thermal conductivity);
% Xx = the first two letters of the German name (Wasser -> Wa, Kupfer -> Ku), copper also Cu.
% Values from usual school tables (20 °C); TeXercises' own table can differ in the last digit.
\def\txlp@c{\joule\per\kilogram\per\kelvin}\def\txlp@L{\joule\per\kilogram}\def\txlp@T{\degreeCelsius}
\def\txlp@R{\kilogram\per\cubic\meter}\def\txlp@a{\per\kelvin}\def\txlp@r{\ohm\meter}\def\txlp@l{\watt\per\meter\per\kelvin}
