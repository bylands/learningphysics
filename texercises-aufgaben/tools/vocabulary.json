  "Circuits": "Direct Current (DC) or Alternating Current (AC)"
 },
 "topic_rules": {
  "Direct Current": "current, resistance, Ohm's law, networks, sources and meters, electric power, RC circuits",
  "Alternating Current": "rms values, reactance, impedance, RLC circuits, filters, transformers (with Electrodynamics)",
  "Electrodynamics": "induction: flux, Faraday, Lenz, motional emf, generators, self-induction, magnetic field energy (Magnetism as a second topic)",
  "Magnetism": "magnetic fields of magnets and currents, Lorentz force, force on conductors, Hall effect",
  "Density": "density and mass of solids and liquids",
  "Hydrostatics": "pressure, hydraulics, hydrostatic pressure, buoyancy, air pressure",
  "Quantities and Units": "units, conversions, orders of magnitude, dimensional analysis (first topic; the physics context as a second)",
  "Measurement Uncertainty": "absolute and relative errors, error propagation, estimates from data",
  "Astrophysics": "stars, luminosity, parallax, galaxies, cosmology (Gravitation/Celestial mechanics only for orbits and Kepler)",
  "Acoustics": "sound speed, sound level, music, ultrasound",
  "Doppler Effect": "every Doppler exercise, sound or light",
  "Interference": "double slit, thin films, interferometers",
  "Diffraction": "gratings, single slit, resolution",
  "Gas Laws": "ideal gas law, gas processes, kinetic gas theory, degrees of freedom",
  "Laws of Thermodynamics": "first and second law, cycles, heat engines, heat pumps",
  "nuclear and particle physics": "mass defect, binding energy, fission, fusion, decay (special relativity as a second topic if E = mc^2 is the point)"
 },
 "tag_rules": [
  "lowercase",
  "in the language of the exercise (names such as 'de broglie' stay as they are)",
  "singular, the spelling already in this list",
  "no tag that only repeats a topic (kinematik, dynamik, electrostatic, ...)"
